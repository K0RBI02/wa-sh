<?xml version="1.0" encoding="utf-8"?>
<!-- Widget: Waschmaschine (rosa) und Trockner (pfirsich) nebeneinander. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/wash_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/wash_widget_wash"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/wash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#212529"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/wash_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#212529"
            android:textSize="28sp"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />

        <TextView
            android:id="@+id/wash_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#212529"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/wash_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#3B4046"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/wash_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressBackgroundTint="#33212529"
            android:progressTint="#212529"
            android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="8dp" android:layout_height="match_parent" />
    <LinearLayout
        android:id="@+id/dry_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/wash_widget_dry"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/dry_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#212529"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/dry_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#212529"
            android:textSize="28sp"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />

        <TextView
            android:id="@+id/dry_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#212529"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/dry_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#3B4046"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/dry_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressBackgroundTint="#33212529"
            android:progressTint="#212529"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
